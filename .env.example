# The Analyst Copilot — environment
# Copy to .env and fill in.   cp .env.example .env
# .env is gitignored. NEVER commit real keys.
#
# This file holds secrets, endpoints and deployment names only.
# Everything tunable (top-k values, thresholds, model→stage bindings) lives in config.yaml.

# ═════════════════════════════════════════════════════════════════════════════
# DATABASE
# ═════════════════════════════════════════════════════════════════════════════
# Local (docker compose up -d) — the reproducible path.
DATABASE_URL=postgresql://copilot:copilot@localhost:5432/analyst_copilot

# Azure Postgres Flexible Server — swap the line above for this one.
# The schema is identical; no Azure-only feature is used.
# Percent-encode @ : / # in the password, or URL parsing breaks.
# DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/analyst_copilot?sslmode=require
#
# Before CREATE EXTENSION works on Azure, allowlist these in the server parameter
# `azure.extensions` (Portal → Server parameters):   vector, pg_trgm, unaccent


# ═════════════════════════════════════════════════════════════════════════════
# MODELS — Azure AI Foundry (or any OpenAI-compatible endpoint)
# ═════════════════════════════════════════════════════════════════════════════
# A `/openai/v1` URL uses OpenAI(base_url=…); a classic one uses AzureOpenAI(azure_endpoint=…).
AZURE_OPENAI_ENDPOINT=                  # https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
GPT_DEPLOYMENT=gpt-5-mini               # extraction, composition, routing, verification

# Verifier B. Same model as the extractor by default; independence then comes from
# adversarial framing (config.yaml `verification`). To use a different model family
# served on the same Foundry route (Grok, DeepSeek, Llama, Mistral), change the deployment.
VERIFIER_B_PROVIDER=azure_openai
VERIFIER_B_DEPLOYMENT=gpt-5-mini

# Embeddings. EMBEDDING_DIMENSIONS MUST EQUAL pages.embedding vector(N) in
# migrations/001_init.sql AND models.embeddings.dimensions in config.yaml.
# config.py asserts they agree at startup, because a mismatch fails every page insert.
EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1024

# Reranker (optional) — Cohere rerank serverless endpoint on Foundry.
COHERE_RERANK_ENDPOINT=
COHERE_RERANK_API_KEY=


# ═════════════════════════════════════════════════════════════════════════════
# PATHS
# ═════════════════════════════════════════════════════════════════════════════
ANALYST_COPILOT_DATA_DIR=./data
FILINGS_DIR=./data/filings                          # one .htm per filing, COMPANY_YEAR_FORM.htm
PRACTICE_QUESTIONS=./data/practice-questions.jsonl
